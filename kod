// Demo alt dosyaları (css, js, görseller) - regex route (Express 4/5 uyumlu)
app.get(/^\/demo\/([a-z0-9-]+)\/(.+)$/, (req, res) => {
    const slug = req.params[0];
    const relPath = req.params[1];

    db.get(`SELECT * FROM demos WHERE slug = ? AND is_active = 1`, [slug], (err, demo) => {
        if (err || !demo) {
            return res.status(404).send('Demo bulunamadı veya erişime kapatıldı.');
        }
        if (!verifyDemoAccess(req, slug)) {
            return res.status(401).send('Erişim engellendi. Lütfen şifreyle giriş yapın.');
        }

        const demoDir = path.join(__dirname, 'public_demos', slug);
        const filePath = path.normalize(path.join(demoDir, relPath));

        // Path traversal koruması
        if (!filePath.startsWith(path.normalize(demoDir + path.sep))) {
            return res.status(403).send('Erişim engellendi.');
        }
        if (!fs.existsSync(filePath) || fs.statSync(filePath).isDirectory()) {
            return res.status(404).send('Dosya bulunamadı.');
        }
        res.sendFile(filePath);
    });
});

