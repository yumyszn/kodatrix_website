const authenticateAdmin = (req, res, next) => {
    const token = req.headers['authorization']?.split(' ')[1];
    if (!token) return res.status(401).json({ error: 'Erişim engellendi, token eksik.' });

    jwt.verify(token, process.env.JWT_SECRET, (err, user) => {
        if (err) return res.status(403).json({ error: 'Geçersiz veya süresi dolmuş token.' });
        req.user = user;
        next();
    });
};

// Görsel yükleme
app.post('/api/admin/upload', authenticateAdmin, upload.single('image'), (req, res) => {
    if (!req.file) return res.status(400).json({ error: 'Görsel yüklenemedi.' });
    res.json({ success: true, url: `/uploads/${req.file.filename}` });
});

// Demo site ZIP yükleme → public_demos/<slug>/ klasörüne açar
app.post('/api/admin/upload-demo', authenticateAdmin, zipUpload.single('zipfile'), (req, res) => {
    const { slug } = req.body;
    if (!slug) return res.status(400).json({ error: 'Slug zorunludur.' });
    if (!req.file) return res.status(400).json({ error: 'ZIP dosyası yüklenemedi.' });

    const targetDir = path.join(__dirname, 'public_demos', slug);

    try {
        const zip = new AdmZip(req.file.path);
        const entries = zip.getEntries();

        // index.html var mı kontrol et (zip kökünde veya tek klasör içinde)
        let hasIndex = entries.some(e => e.entryName.endsWith('index.html'));
        let stripPrefix = '';

        if (!hasIndex) {
            // Zip içinde tek klasör varsa (örn: site/index.html), o klasörü atla
            const topLevelDirs = new Set(
                entries
                    .filter(e => !e.isDirectory)
                    .map(e => e.entryName.split('/')[0])
            );
            if (topLevelDirs.size === 1) {
                stripPrefix = [...topLevelDirs][0] + '/';
                hasIndex = entries.some(e => e.entryName === stripPrefix + 'index.html');
            }
        }

        if (!hasIndex) {
            fs.unlinkSync(req.file.path);
            return res.status(400).json({ error: 'ZIP içinde index.html bulunamadı. Ana sayfanın index.html olduğundan emin olun.' });
        }

        // Hedef klasörü temizle ve oluştur
        if (fs.existsSync(targetDir)) fs.rmSync(targetDir, { recursive: true, force: true });
        fs.mkdirSync(targetDir, { recursive: true });

        // Dosyaları çıkar
        zip.extractAllTo(targetDir, true);

        // Tek klasör içindeyse, içeriği bir üst seviyeye taşı
        if (stripPrefix) {
            const innerDir = path.join(targetDir, stripPrefix);
            const parent = path.dirname(targetDir);
            const tempDir = path.join(parent, 'temp_' + Date.now());
            fs.renameSync(innerDir, tempDir);
            fs.rmSync(targetDir, { recursive: true, force: true });
            fs.renameSync(tempDir, targetDir);
        }

        // Geçici zip dosyasını sil
        fs.unlinkSync(req.file.path);

        res.json({ success: true, message: 'Demo dosyaları yüklendi ve açıldı.' });
    } catch (err) {
        if (req.file && fs.existsSync(req.file.path)) fs.unlinkSync(req.file.path);
        res.status(500).json({ error: 'ZIP açılırken hata oluştu: ' + err.message });
    }
});

