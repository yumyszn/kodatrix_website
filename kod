app.post('/api/contact', (req, res) => {
    const { customer_name, phone, email, message } = req.body;

    if (!customer_name || !phone) {
        return res.status(400).json({ error: 'Ad soyad ve telefon alanı zorunludur.' });
    }

    // Telefon doğrulama: 0 ile başlayan 11 haneli numara (örn: 0501 234 56 78)
    const digits = phone.replace(/\D/g, ''); // Sadece rakamlar
    const isValidPhone = /^0?5\d{9}$/.test(digits); // 5XXXXXXXXX (10) veya 05XXXXXXXXX (11)
    if (!isValidPhone) {
        return res.status(400).json({ error: 'Geçerli bir telefon numarası girin (örn: 0501 234 56 78).' });
    }

    const query = `INSERT INTO leads (customer_name, phone, email, message) VALUES (?, ?, ?, ?)`;
    db.run(query, [customer_name, phone, email || null, message || null], function (err) {
        if (err) return res.status(500).json({ error: 'Talep kaydedilemedi.' });
        res.status(201).json({ success: true, message: 'Talebiniz başarıyla alındı.' });
    });
});

