// Cookie okuma yardımcısı (ek bağımlılık gerekmez)
function getCookie(req, name) {
    const header = req.headers.cookie || '';
    const pair = header.split(';').map(c => c.trim()).find(c => c.startsWith(name + '='));
    return pair ? decodeURIComponent(pair.split('=').slice(1).join('=')) : null;
}

// Demo erişim çerezi geçerli mi?
function verifyDemoAccess(req, slug) {
    const token = getCookie(req, `demo_${slug}`);
    if (!token) return false;
    try {
        const payload = jwt.verify(token, process.env.JWT_SECRET);
        return payload.demo === slug;
    } catch {
        return false;
    }
}

// Şifre kontrolü + erişim çerezi oluşturma
app.post('/demo/:slug', (req, res) => {
    const { slug } = req.params;
    const { password } = req.body;

    db.get(`SELECT * FROM demos WHERE slug = ? AND is_active = 1`, [slug], (err, demo) => {
        if (err || !demo) {
            return res.status(404).json({ error: 'Demo bulunamadı veya erişime kapatıldı.' });
        }
        if (password !== demo.auth_password) {
            return res.status(401).json({ error: 'Hatalı şifre.' });
        }
        // Demo erişim çerezi oluştur (1 saat geçerli) - alt dosyalar da bu çerezle korunur
        const demoToken = jwt.sign({ demo: slug }, process.env.JWT_SECRET, { expiresIn: '1h' });
        res.setHeader('Set-Cookie', `demo_${slug}=${encodeURIComponent(demoToken)}; Path=/; HttpOnly; Max-Age=3600; SameSite=Lax`);
        res.json({ success: true, message: 'Şifre doğru, demo açılıyor.' });
    });
});

// Demo giriş noktası: çerez yoksa şifre sayfası, varsa ana sayfaya yönlendir
